rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 100 && slug.matches('^[a-z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Per-Event RSVP Validation Blueprint (expression-budget safe for all 6 events) ---
    function isValidEventRsvpEntry(entry, allowAlcohol) {
      return entry is map &&
        entry.size() == 4 &&
        entry.keys().hasOnly(['attending', 'headcount', 'foodPreference', 'alcoholPreference']) &&
        (
          (
            entry.attending == 'coming' &&
            entry.headcount is int &&
            entry.headcount >= 1 &&
            entry.headcount <= 50 &&
            (entry.foodPreference == null || entry.foodPreference == 'veg' || entry.foodPreference == 'non_veg') &&
            (entry.alcoholPreference == null || (allowAlcohol && (entry.alcoholPreference == 'alcohol' || entry.alcoholPreference == 'no_alcohol')))
          ) || (
            entry.attending == 'not_coming' &&
            entry.headcount == null &&
            entry.foodPreference == null &&
            entry.alcoholPreference == null
          )
        );
    }

    function isValidRsvp(rsvp) {
      return rsvp == null || (
        rsvp is map &&
        rsvp.size() == 2 &&
        rsvp.keys().hasOnly(['byEvent', 'respondedAt']) &&
        rsvp.byEvent is map &&
        rsvp.byEvent.keys().hasOnly([
          'mehendi-cocktail', 'aiburobhat', 'haldi', 'wedding', 'boubhat', 'reception'
        ]) &&
        (!('mehendi-cocktail' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['mehendi-cocktail'], true)) &&
        (!('aiburobhat' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['aiburobhat'], false)) &&
        (!('haldi' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['haldi'], false)) &&
        (!('wedding' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['wedding'], false)) &&
        (!('boubhat' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['boubhat'], false)) &&
        (!('reception' in rsvp.byEvent) || isValidEventRsvpEntry(rsvp.byEvent['reception'], false)) &&
        rsvp.respondedAt is timestamp
      );
    }

    // --- Validation Blueprint ---
    function isValidInvitation(data, slug) {
      return data.keys().hasAll([
          'slug', 'side', 'guestNames', 'withFamily', 'displayGuestName',
          'eventIds', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slug', 'side', 'guestNames', 'withFamily', 'displayGuestName',
          'eventIds', 'createdBy', 'createdAt', 'updatedAt', 'rsvp', 'isGeneric'
        ]) &&
        data.slug is string && data.slug == slug && isValidSlug(data.slug) &&
        data.side is string && data.side.size() >= 1 && data.side.size() <= 20 && data.side in ['bride', 'groom'] &&
        data.guestNames is list &&
        data.guestNames.size() >= 1 && data.guestNames.size() <= 20 &&
        data.guestNames[0] is string &&
        data.guestNames[0].size() >= 1 && data.guestNames[0].size() <= 120 &&
        data.withFamily is bool &&
        data.displayGuestName is string &&
        data.displayGuestName.size() >= 1 && data.displayGuestName.size() <= 300 &&
        data.eventIds is list &&
        data.eventIds.size() >= 1 && data.eventIds.size() <= 20 &&
        data.eventIds[0] is string &&
        data.eventIds[0].size() >= 1 && data.eventIds[0].size() <= 80 &&
        data.createdBy is string && isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('rsvp' in data) || isValidRsvp(data.rsvp)) &&
        (!('isGeneric' in data) || data.isGeneric is bool);
    }

    function isGenericImmutable() {
      return (!('isGeneric' in incoming()) && !('isGeneric' in existing())) ||
        ('isGeneric' in incoming() && 'isGeneric' in existing() && incoming().isGeneric == existing().isGeneric);
    }

    // --- Collection: invitations (no-auth studio per user request, schema-hardened) ---
    match /invitations/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if resource.data.createdBy == 'studio-host';
      allow create: if isValidSlug(slug) &&
        isValidInvitation(incoming(), slug) &&
        incoming().createdBy == 'studio-host' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('rsvp' in incoming()) || incoming().rsvp == null);
      allow update: if isValidSlug(slug) &&
        isValidInvitation(incoming(), slug) &&
        incoming().slug == existing().slug &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        isGenericImmutable() &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Host edits personalized invitation details (guest names, side, events)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'side', 'guestNames', 'withFamily', 'displayGuestName', 'eventIds', 'updatedAt'
          ]) ||
          // Action 2: Guest or host submits/updates/clears per-event RSVP responses on personalized invites only
          (
            (!('isGeneric' in existing()) || existing().isGeneric == false) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rsvp', 'updatedAt']) &&
            'rsvp' in incoming() &&
            (incoming().rsvp == null || incoming().rsvp.respondedAt == request.time)
          )
        );
      allow delete: if isValidSlug(slug);
    }
  }
}
